  IsoConserve.PaperClaims.core_closed_wait_set_absorbing
  IsoConserve.PaperClaims.L3_wait_component_absorption
  IsoConserve.PaperClaims.L4_stock_integral
  IsoConserve.PaperClaims.L4_for_core_reachable
  IsoConserve.PaperClaims.detection_sound
  IsoConserve.PaperClaims.detection_complete_bounded
  IsoConserve.PaperClaims.detection_latency_le_budget
  IsoConserve.PaperClaims.live_process_not_detected
  IsoConserve.PaperClaims.progress_signal_useful_kept
  IsoConserve.PaperClaims.progress_signal_spinner_reclaimed
